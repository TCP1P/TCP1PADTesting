# yaml-language-server: $schema=https://raw.githubusercontent.com/dimasma0305/gzcli/refs/heads/main/internal/template/templates/others/ctf-template/.gzctf/gzevent.schema.yaml

# Event manifest for the TCP1P A&D testing challenges.
#
# The GZCTF repo scanner (admin -> Repo Bindings) discovers this file and
# creates/updates a Game from it; every challenge.yml under this directory
# (owasp-portal/, pwn-armory/) is imported into that game. Imported challenges
# stay HIDDEN until you enable them in the admin UI.

title: "TCP1P A&D + KotH Testing"
summary: "Four targets: OWASP-Top-10 and PWN, in both Attack & Defense and King of the Hill."
content: |
  ## TCP1P Attack & Defense + King of the Hill — testing event

  Four services on one A&D engine:

  **Attack & Defense** (one instance per team; flag rotates each tick):
  - **owasp-portal** — notes portal; each feature hides one OWASP Top 10 (2021)
    vuln; all ten leak the flag.
  - **pwn-armory** — heap item-manager binary (no canary/PIE/RELRO) with ten
    classic memory-corruption bug classes.

  **King of the Hill** (one SHARED hill; plant your per-round token in
  `/koth/king` and hold it):
  - **koth-throne** — OWASP-Top-10 web hill; each vuln lets you write the
    exact token to `/koth/king` (reach the admin crown or write the marker).
  - **koth-pwn** — binary hill; memory-corruption flips `is_admin` or `ret2
    do_crown()` to enthrone your token.

  Keep your service/hill healthy, patch the bugs, and (A&D) steal + submit
  flags or (KotH) hold the marker.

# ISO-8601. Local offsets are fine — normalized to UTC on import.
# WITA = UTC+8: 10:00 → 22:00 (10 at night) on 2026-05-30.
start: "2026-05-30T10:00:00+08:00"
end: "2026-05-30T22:00:00+08:00"

hidden: true               # keep hidden until you flip it in the admin UI
practiceMode: true
acceptWithoutReview: false
teamMemberCountLimit: 5
containerCountLimit: 5

# Event-wide Attack & Defense settings — shared by EVERY A&D challenge here.
ad:
  tickSeconds: 60              # round length in seconds
  flagLifetimeTicks: 5         # ticks a planted flag stays submittable
  warmupSeconds: 600           # grace after start before scoring begins
  resetCooldownMinutes: 5      # min minutes between a team's self-resets
  allowSnapshotDownload: true
